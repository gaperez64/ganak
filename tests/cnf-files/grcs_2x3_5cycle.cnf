c GRCS-style circuit: 2x3 grid: H^6 CZ(0,1) CZ(2,3) CZ(4,5) T^6 CZ(1,2) CZ(3,4) H^6
c c RUN: %solver --mode 6 --rw 1 %s | %OutputCheck %s
p cnf 6 0
c t wmc
c rw_sop 6 8 0 1 1 1 1 1 1
c rw_edge 0 1
c rw_edge 1 2
c rw_edge 2 3
c rw_edge 3 4
c rw_edge 4 5
c c CHECK: ^s SATISFIABLE$
c c CHECK: ^c s exact quadruple float 6\.48528137e\+00 \+ 8\.82842712e\+00i$
