c GRCS-style circuit: 2x2 grid: H^4 CZ(0,1) CZ(2,3) T^4 CZ(0,2) CZ(1,3) H^4
c c RUN: %solver --mode 6 --rw 1 %s | %OutputCheck %s
p cnf 4 0
c t wmc
c rw_sop 4 8 0 1 1 1 1
c rw_edge 0 1
c rw_edge 0 2
c rw_edge 1 3
c rw_edge 2 3
c c CHECK: ^s SATISFIABLE$
c c CHECK: ^c s exact quadruple float 0\.0*e\+00 \+ 3\.65685425e\+00i$
