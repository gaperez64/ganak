c Weighted 3-variable formula to test treewidth FPT WMC dispatch (mode 1)
c Clauses: (x1 v x2) /\ (x2 v x3) /\ (x1 v x3); tw=2; WMC=197/250
c Weights: pos(x1)=0.8 neg=0.2, pos(x2)=0.6 neg=0.4, pos(x3)=0.7 neg=0.3
c c RUN: %solver --mode 1 --tw 1 --twmaxk 5 %s | %OutputCheck %s
p cnf 3 3
1 2 0
2 3 0
1 3 0
c t wmc
c p weight 1 0.8 0
c p weight -1 0.2 0
c p weight 2 0.6 0
c p weight -2 0.4 0
c p weight 3 0.7 0
c p weight -3 0.3 0
c c CHECK: ^s SATISFIABLE$
c c CHECK: ^c o exact quadruple float 7\.880*e\-01$
